# Local demonstration only. Copy to .env before docker compose up --build.
APP_ENV=development
ENABLE_DEV_AUTH=true
DEV_PASSWORD=focuslock-local-only
# Replace for any real deployment; at least 32 random characters. Keep identical across API replicas.
QR_SIGNING_KEY=focuslock-local-qr-key-change-before-any-deployment-2026
POLICY_SIGNING_KEY=focuslock-local-policy-key-change-before-deployment-2026
BLE_TOKEN_KEY=focuslock-local-ble-key-change-before-deployment-2026
DEV_RECEIVER_TOKEN=focuslock-local-receiver-token-change-me
# Replace with exact HTTPS college document hosts you are authorized to use.
RESOURCE_ALLOWED_HOSTS=college.example.edu,docs.college.example.edu
POSTGRES_USER=focuslock
POSTGRES_PASSWORD=focuslock-local-db
POSTGRES_DB=focuslock
CORS_ORIGINS=http://localhost:5173
# Face check: off, enrolled (only students whose face staff recorded), or required (everyone).
FACE_CHECK_MODE=enrolled
# Decrypted templates are not returned by default. Enable only for local demo matching.
FACE_TEMPLATE_CLIENT_DOWNLOAD=false
# Encrypts stored face templates. Replace for any real deployment; at least 32 random characters.
FACE_TEMPLATE_KEY=focuslock-local-face-key-change-before-deployment-2026

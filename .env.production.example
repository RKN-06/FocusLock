# Documentation only. Set these in your deployment secret store; do not commit a filled copy.
APP_ENV=production
ENABLE_DEV_AUTH=false
# Exact psycopg SQLAlchemy URL from your managed PostgreSQL provider.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB?sslmode=require
QR_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
POLICY_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
BLE_TOKEN_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
RESOURCE_ALLOWED_HOSTS=docs.college.example.edu
OIDC_ISSUER=https://idp.college.example.edu
OIDC_AUDIENCE=focuslock-api
OIDC_JWKS_URL=https://idp.college.example.edu/keys
OIDC_AUTHORIZATION_ENDPOINT=https://idp.college.example.edu/authorize
OIDC_TOKEN_ENDPOINT=https://idp.college.example.edu/token
OIDC_DASHBOARD_CLIENT_ID=REPLACE_WITH_COLLEGE_PUBLIC_CLIENT_ID
OIDC_DASHBOARD_REDIRECT_URI=https://focuslock.college.example.edu/
OIDC_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_PUBLIC_CLIENT_ID
OIDC_ANDROID_REDIRECT_URI=focuslock://oidc/callback
PLAY_INTEGRITY_MODE=optional
PLAY_INTEGRITY_PACKAGE=org.focuslock.app
# Set as a secret JSON value after linking a real Google Cloud project.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_16_BYTES
RETENTION_EVENT_DAYS=30
RETENTION_SIGHTING_DAYS=7
RETENTION_CREDENTIAL_DAYS=1
CORS_ORIGINS=https://focuslock.college.example.edu
FACE_CHECK_MODE=off
# Keep false unless a reviewed hardware-backed matching design is deployed.
FACE_TEMPLATE_CLIENT_DOWNLOAD=false
# Encrypts stored face templates; random, 32+ bytes, kept identical across API replicas.
FACE_TEMPLATE_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES
